# Plain KEY=VALUE lines, read as data: no quotes, no shell expansion.
# Allowed keys: CA_NAME, CERT_PRINCIPALS, CERT_EXTENSIONS, CERT_IDENTITY
CA_NAME=my-user-ca
CERT_PRINCIPALS=root
CERT_EXTENSIONS=clear,permit-agent-forwarding,permit-port-forwarding,permit-pty
# CERT_IDENTITY defaults to <user>@<hostname>
